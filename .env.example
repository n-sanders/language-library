# Path to the SQLite database file. The folder is created automatically.
# Local: ./data/app.db   Docker: /data/app.db (set in docker-compose.yml)
DATABASE_PATH=./data/app.db

# Used to encrypt the OpenRouter API key stored in the database.
# Use a long random string in production. If you change it, re-enter the API key in admin settings.
APP_SECRET=dev-only-change-me-to-a-long-random-string

# The admin account is created on first startup if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
